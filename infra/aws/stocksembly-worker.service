[Unit]
Description=Stocksembly research worker
After=network-online.target stocksembly-web.service
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/stocksembly/app
Environment=NODE_ENV=production
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
Environment=TMPDIR=/home/ec2-user/.codex/tmp
EnvironmentFile=/etc/stocksembly/aws.env
EnvironmentFile=-/etc/stocksembly/app.env
ExecStart=/usr/bin/node .next/standalone/research-worker/worker.mjs serve
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
