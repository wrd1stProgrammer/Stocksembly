# Copy to /etc/stocksembly/app.env on the EC2 instance and chmod 0600.
# Do not commit or upload the real values.
INSIGHTSENTRY_RAPIDAPI_KEY=
INSIGHTSENTRY_RAPIDAPI_HOST=insightsentry.p.rapidapi.com
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Research: up to ten runs with API enabled (four without API).
# Every model task prefers Pro; queued tasks spill to API after 30 seconds.
# Keep web and worker settings identical. Enable only after installing separate API auth.
STOCKSEMBLY_CODEX_API_ENABLED=0
# Separate API-only Codex auth.json, owned by the worker user, mode 0600.
# This path is inside the existing EC2 Codex bind mount; never replace its main auth.json.
STOCKSEMBLY_CODEX_API_AUTH_PATH=/home/ec2-user/.codex/api/auth.json
STOCKSEMBLY_GLOBAL_CODEX_PROCESSES=12
# Task slots shared fairly across runs, not a quota per research.
STOCKSEMBLY_CODEX_PRO_CONCURRENCY=10
STOCKSEMBLY_CODEX_API_CONCURRENCY=6
STOCKSEMBLY_CODEX_API_SPILL_AFTER_MS=30000
